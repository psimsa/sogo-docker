# Copy to .env and adjust:
#   cp docker/.env.example docker/.env

# --- SOGo container ---------------------------------------------------------
# Image name / tag used by the sample compose file.
SOGO_IMAGE=docker.io/psimsa/sogo:latest
# Public hostname SOGo is served under (used for the Traefik router rule).
SOGO_HOST=mail.example.com
# Number of sogod worker processes.
# ActiveSync needs roughly one worker per concurrently syncing device.
SOGO_WORKERS=8
# uid/gid of the "sogo" user inside the container (build args) — match the
# ownership of host paths you bind-mount into the container (e.g. /var/lib/sogo).
SOGO_UID=1000
SOGO_GID=1000
# Container timezone (IANA zone name).
TZ=Etc/UTC

# --- Traefik -----------------------------------------------------------------
# Entrypoint and certificate resolver of your existing Traefik instance.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- helper services (this compose file only) --------------------------------
POSTGRES_PASSWORD=please-change-me
# memcached memory limit in MiB.
MEMCACHED_MEMORY=64
